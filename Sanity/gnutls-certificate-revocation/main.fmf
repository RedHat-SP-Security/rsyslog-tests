summary: Test for GnuTLS certificate revocation checking (stapled OCSP)
description: Verify that rsyslog with GnuTLS correctly handles OCSP certificate revocation by accepting connections when the server certificate is valid and refusing connections when the server certificate has been revoked via stapled OCSP responses.
contact: Anderson Toshiyuki Sasaki <ansasaki@redhat.com>
component:
  - rsyslog
test: ./runtest.sh
require:
  - library(openssl/certgen)
recommend:
  - rsyslog
  - openssl
  - rsyslog-gnutls
  - policycoreutils-python-utils
duration: 5m
enabled: true
tag:
  - NoRHEL4
  - NoRHEL5
  - NoRHEL6
  - NoRHEL7
  - TIPfail
  - TIPfail_Security
  - rhel-8.0.0
  - customer_scenario
extra-summary: /CoreOS/rsyslog/Sanity/gnutls-certificate-revocation
extra-task: /CoreOS/rsyslog/Sanity/gnutls-certificate-revocation
adjust:
  - enabled: false
    when: distro < rhel-8.2
    continue: false
extra-nitrate: TC#0611304
id: 08945f37-f5c5-4cfe-8813-f523fc869dbb
