summary: Test impstats module Zabbix LLD output format
description: |
    Verify that the impstats module produces valid JSON output in Zabbix LLD
    format and does not emit legacy key=value format when configured with
    format="zabbix".
contact: Adam Prikryl <aprikryl@redhat.com>
test: ./runtest.sh
duration: 10m
enabled: true
require:
  - url: https://github.com/RedHat-SP-Security/rsyslog-tests.git
    name: /Library/basic
    type: library
  - rsyslog
tag:
  - NoRHEL6
  - NoRHEL7
  - NoRHEL8
  - NoRHEL9
  - Tier1
  - CI-Tier-1
tier: 1
adjust:
  - enabled: false
    when: distro < rhel-10.2
    because: impstats format="zabbix" requires upstream PR #6154
id: fcd9013f-153c-4057-aa63-58bfe4a73036
