summary: basic ipv6 sanity testing
description: |
    Verify that rsyslog correctly sends and receives log messages over IPv6
    using both UDP and TCP protocols, and that messages sent via IPv4 are
    not received when the server is configured to listen on IPv6 only.
contact: Dalibor Pospíšil <dapospis@redhat.com>
component:
  - rsyslog7
  - rsyslog
  - rsyslog
  - rsyslog5
test: ./runtest.sh
recommend:
  - rsyslog
  - nc
duration: 2h
enabled: true
tag+:
  - RHEL6
  - fedora-wanted
  - rsyslogSyntaxOLD
extra-summary: /CoreOS/rsyslog/Multihost/ipv6-sanity-test
extra-nitrate: TC#0098169
adjust:
  - enabled: false
    when: distro != rhel-6
    continue: false
id: f47649b7-bf1b-4aba-a391-154f76a9fcb9
